# =============================================================================
# Digital Humans — backend configuration
#
# THIS FILE IS THE ONLY ENV TEMPLATE. Copy it to backend/.env.
#
# LOT-E / P12: there is exactly ONE .env. The RAG service used to fall back to
# a second file (/opt/digital-humans/rag/.env) when OPENAI_API_KEY was missing,
# so two OpenAI keys could coexist with no way to tell which was live. That
# fallback is gone: set OPENAI_API_KEY here and nowhere else.
# =============================================================================

# Database Configuration
DATABASE_URL=postgresql://digital_humans:changeme@localhost:5432/digital_humans_db

# Security
# SECRET_KEY signs JWTs. Required when DEBUG=False.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-must-be-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CREDENTIALS_ENCRYPTION_KEY encrypts Salesforce and Git credentials at rest
# (project_credentials.encrypted_value). REQUIRED when DEBUG=False.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# It is deliberately separate from SECRET_KEY: rotating SECRET_KEY must not
# make every stored credential undecryptable. To change this key, re-encrypt
# the existing rows first:
#   python scripts/rotate_encryption_key.py --new-key <new-key> --apply
CREDENTIALS_ENCRYPTION_KEY=

# OpenAI API — single source for the application AND the RAG embeddings.
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4

# Server Configuration
HOST=0.0.0.0
PORT=8002
RELOAD=True
DEBUG=True

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:5173

# Logging
LOG_LEVEL=INFO
DH_LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Paths (P2). Every default is derived from the checkout root, so a fresh clone
# runs as-is. Deployments whose data lives OUTSIDE the checkout must set the
# matching variable explicitly — nothing is guessed any more.
#
# On the VPS the ChromaDB store and the SFDX workspace live under /opt and the
# BUILD deliverables under /var/lib: those four variables MUST be set there.
# -----------------------------------------------------------------------------
# DH_PROJECT_ROOT=
# DH_BACKEND_ROOT=
# DH_OUTPUT_DIR=
# DH_METADATA_DIR=
# DH_CHROMA_PATH=/opt/digital-humans/rag/chromadb_data
# DH_LLM_CONFIG_PATH=
# DH_DELIVERABLES_DIR=/var/lib/digital-humans/livrables
# DH_SFDX_PROJECT_PATH=/opt/digital-humans/salesforce-workspace/digital-humans-sf
# DH_FORCE_APP_PATH=/opt/digital-humans/salesforce-workspace/digital-humans-sf/force-app/main/default
# DH_AGENTS_DIR=/opt/digital-humans/salesforce-agents
