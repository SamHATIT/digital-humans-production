# =============================================================================
# Digital Humans — environnement de TEST (vague 0 / AS-02, OPS-05, 16/09/2026)
#
# Ce fichier est versionné et NE CONTIENT AUCUN SECRET. Il est le seul fichier
# d'environnement lu par une session pytest : `tests/hermetic.py` pose
# DH_ENV_FILE sur ce chemin avant tout import applicatif, et `app.main` /
# `app.config` le respectent. `backend/.env` (clés réelles) n'est jamais lu.
#
# Ce qui n'est PAS ici, volontairement :
#   - TEST_DATABASE_URL : à exporter par l'exécutant (gabarit d'une base
#     jetable ; la session en dérive une base par exécution). Voir
#     tests/README.md.
#   - DATABASE_URL, DH_ARQ_QUEUE_NAME : dérivés par le bootstrap.
#   - DH_OUTPUT_DIR, DH_CHROMA_PATH, ... : un répertoire temporaire de session.
#
# Règle : une variable de secret vaut « vide » ou commence par `dh-test-fake-`.
# Toute autre valeur, ici ou dans l'environnement, fait refuser la session.
# =============================================================================

DEBUG=True
SECRET_KEY=dh-test-fake-secret-key-0123456789abcdef0123456789abcdef
CREDENTIALS_ENCRYPTION_KEY=
# AUTO_CREATE_SCHEMA : non posé (pas de create_all au boot ; les fixtures créent
# les tables). Une valeur vide n'est pas lisible par pydantic : on l'omet.
DH_LOG_FORMAT=plain
LOG_LEVEL=INFO

# --- Clés d'API et jetons : factices ou vides ---------------------------------
ANTHROPIC_API_KEY=dh-test-fake-anthropic-key
OPENAI_API_KEY=dh-test-fake-openai-key
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
GHOST_ADMIN_KEY=
GHOST_CONTENT_KEY=
GIT_TOKEN=
GITTOKEN=
GITHUB_TOKEN=
GIT_SSH_KEY=
SALESFORCE_TOKEN=
SALESFORCE_REFRESH_TOKEN=
SMTP_PASSWORD=
JOURNAL_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
CHAT_IP_SALT=dh-test-fake-salt

# --- Aucune org Salesforce par défaut (gem:CONF-01) : SF_* non posés ----------

# --- Redis : base dédiée (0 = cache prod, 1 = file ARQ prod : refusées) --------
# DH_REDIS_HOST et DH_REDIS_PORT peuvent être posés par l'exécutant.
DH_REDIS_DB=9

# --- Messagerie : jamais SMTP en test ----------------------------------------
EMAIL_BACKEND=console
