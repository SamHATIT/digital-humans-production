{# sec-7 : Gap Analysis (Marcus) - 99 gaps, summary tables, migration, risks.
   La sec-7.4 Risk Areas dans la ref a un bug (texte en col 1 strong, severity
   '—', description vide). On reproduit la structure visuelle pour rester aligne. #}
{% set total_gaps = gap.summary.total_gaps if 'total_gaps' in gap.summary else 0 %}{% set agent_total = gap.summary.by_agent.values() | sum if 'by_agent' in gap.summary else 0 %}<section id='sec-7' class='block'>
<div class='act'><span class='act-num'>{{ _("— Scene VII") }}</span><span class='act-sep'></span><span class='act-tag'>{{ _("Artifact 07") }}</span></div><h1 class='sec-h1'><span>{{ _("Gap Analysis") }}</span> <em class='brass'>{{ _("(Marcus — Solution Architect)") }}</em></h1>
<p>{{ _("Marcus identified") }} {{ total_gaps }} {{ _("gaps to fill, totalling an estimated") }} {{ gap.summary.total_effort_days if 'total_effort_days' in gap.summary else '—' }} {{ _("effort-days.") }}</p>
<h2 id='sub-7-1' class='sec-h2'><span>{{ _("7.1 Summary") }}</span></h2>
<table class='tbl'>
<thead><tr>
<th>{{ _("Total gaps") }}</th>
<th><strong>{{ total_gaps }}</strong></th>
</tr></thead>
<tbody>
<tr>
<td>{{ _("Total effort (days)") }}</td>
<td><strong>{{ gap.summary.total_effort_days if 'total_effort_days' in gap.summary else '—' }}</strong></td>
</tr>
</tbody></table>
<h3 class='sec-h3'>{{ _("Gaps by category") }}</h3>
<table class='tbl'>
<thead><tr>
<th><strong>{{ _("Category") }}</strong></th>
<th><strong>{{ _("Count") }}</strong></th>
<th><strong>{{ _("% of total") }}</strong></th>
</tr></thead>
<tbody>
{% for cat, cnt in (gap.summary.by_category if 'by_category' in gap.summary else {}).items() %}<tr>
<td><strong>{{ cat }}</strong></td>
<td><strong>{{ cnt }}</strong></td>
<td>{{ ((cnt / total_gaps * 100) | round(1)) if total_gaps > 0 else 0 }}%</td>
</tr>
{% endfor %}</tbody></table>
<h3 class='sec-h3'>{{ _("Gaps by complexity") }}</h3>
<table class='tbl'>
<thead><tr>
<th><strong>{{ _("Complexity") }}</strong></th>
<th><strong>{{ _("Count") }}</strong></th>
<th><strong>{{ _("% of total") }}</strong></th>
</tr></thead>
<tbody>
{% for cx, cnt in (gap.summary.by_complexity if 'by_complexity' in gap.summary else {}).items() %}<tr>
<td><strong>{{ cx }}</strong></td>
<td><strong>{{ cnt }}</strong></td>
<td>{{ ((cnt / total_gaps * 100) | round(1)) if total_gaps > 0 else 0 }}%</td>
</tr>
{% endfor %}</tbody></table>
<h3 class='sec-h3'>{{ _("Gaps by responsible agent") }}</h3>
<table class='tbl'>
<thead><tr>
<th><strong>{{ _("Agent") }}</strong></th>
<th><strong>{{ _("Gap count") }}</strong></th>
<th><strong>{{ _("% of total") }}</strong></th>
</tr></thead>
<tbody>
{% for ag, cnt in (gap.summary.by_agent if 'by_agent' in gap.summary else {}).items() %}<tr>
<td><strong>{{ ag }}</strong></td>
<td><strong>{{ cnt }}</strong></td>
<td>{{ ((cnt / agent_total * 100) | round(1)) if agent_total > 0 else 0 }}%</td>
</tr>
{% endfor %}</tbody></table>
<h2 id='sub-7-2' class='sec-h2'><span>{{ _("7.2 Gap Catalog") }}</span> <em class='brass'>({{ total_gaps }} {{ _("gaps)") }}</em></h2>
<p>{{ _("Each gap with category, complexity, responsible agent, effort estimate and acceptance criteria. Sorted as produced by Marcus.") }}</p>
<table class='tbl'>
<thead><tr>
<th><strong>ID</strong></th>
<th><strong>{{ _("Title / Description") }}</strong></th>
<th><strong>{{ _("Category") }}</strong></th>
<th><strong>{{ _("Complexity") }}</strong></th>
<th><strong>{{ _("Effort (d)") }}</strong></th>
<th><strong>{{ _("Agent") }}</strong></th>
</tr></thead>
<tbody>
{% for g in gap.gaps %}<tr>
<td><strong>{{ g.id }}</strong></td>
<td>{{ g.gap_description }}</td>
<td>{{ g.category }}</td>
<td><strong>{{ g.complexity }}</strong></td>
<td><strong>{{ g.effort_days }}</strong></td>
<td>{{ g.assigned_agent or '—' }}</td>
</tr>
{% endfor %}</tbody></table>
<h2 id='sub-7-3' class='sec-h2'><span>{{ _("7.3 Migration Considerations") }}</span></h2>
{% for mc in gap.migration_considerations %}<p>- {{ mc }}</p>
{% endfor %}<h2 id='sub-7-4' class='sec-h2'><span>{{ _("7.4 Risk Areas") }}</span></h2>
<table class='tbl'>
<thead><tr>
<th><strong>{{ _("Risk area") }}</strong></th>
<th><strong>{{ _("Severity") }}</strong></th>
<th><strong>{{ _("Description / mitigation") }}</strong></th>
</tr></thead>
<tbody>
{% for ra in gap.risk_areas %}<tr>
<td><strong>{{ ra }}</strong></td>
<td><strong>—</strong></td>
<td></td>
</tr>
{% endfor %}</tbody></table>
</section>
