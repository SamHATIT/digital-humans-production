<section id='sec-1' class='block'>
<div class='act'><span class='act-num'>{{ _("— Scene I") }}</span><span class='act-sep'></span><span class='act-tag'>{{ _("Artifact 01") }}</span></div><h1 class='sec-h1'><span>{{ _("Project Overview") }}</span></h1>
<h2 id='sub-1-1' class='sec-h2'><span>{{ _("1.1 Project Identity") }}</span></h2>
<table class='tbl'>
<thead><tr>
<th>{{ _("Project name") }}</th>
<th><strong>{{ project.name | ftrim }}</strong></th>
</tr></thead>
<tbody>
<tr>
<td>{{ _("Description") }}</td>
<td>{{ project.description }}</td>
</tr>
<tr>
<td>{{ _("Execution") }}</td>
<td>#{{ execution.id }}</td>
</tr>
</tbody></table>
<h2 id='sub-1-2' class='sec-h2'><span>{{ _("1.2 Initial Business Needs") }}</span> <em class='brass'>{{ _("(User Brief)") }}</em></h2>
<p>{{ _("The following needs were submitted in the original brief and triggered Sophie's requirements extraction.") }}</p>
<table class='tbl'>
<thead><tr>
<th><strong>#</strong></th>
<th><strong>{{ _("Need") }}</strong></th>
</tr></thead>
<tbody>
{% for need in initial_needs %}<tr>
<td>{{ loop.index }}</td>
<td>{{ need }}</td>
</tr>
{% endfor %}</tbody></table>
<p class='note'>{{ _("These") }} {{ initial_needs | length }} {{ _("informal needs were transformed by Sophie into") }} {{ br_data.business_requirements | length }} {{ _("structured Business Requirements, then by Olivia into") }} {{ uc_data.use_cases | length }} {{ _("Use Cases — see sections 2 and 3.") }}</p>
</section>
