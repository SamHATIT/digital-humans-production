{# sec-8 : Coverage Report (Emma) - score, by_category, critical_gaps.
   Reuse 'coverage' deja expose dans le contexte (collect_coverage). #}
{% set crit_count = coverage.critical_gaps | length %}{% set missing_pct = (100 - coverage.score) | round(1) %}<section id='sec-8' class='block'>
<div class='act'><span class='act-num'>{{ _("— Scene VIII") }}</span><span class='act-sep'></span><span class='act-tag'>{{ _("Artifact 08") }}</span></div><h1 class='sec-h1'><span>{{ _("Coverage Report") }}</span> <em class='brass'>{{ _("(Emma — Research Analyst)") }}</em></h1>
<p><strong>{{ coverage.score }}%</strong></p>
<p><strong>{{ _v(coverage.verdict) }}</strong></p>
<p>{{ _("Emma's programmatic validator scored Marcus's solution design at") }} {{ coverage.score }}{{ _("%. Verdict thresholds: approved from 95%, minor revision from 80%. Method:") }} {{ coverage.scoring_method }}.</p>
<h2 id='sub-8-1' class='sec-h2'><span>{{ _("8.1 Score by Category") }}</span></h2>
<table class='tbl'>
<thead><tr>
<th><strong>{{ _("Category") }}</strong></th>
<th><strong>{{ _("Score") }}</strong></th>
<th><strong>{{ _("Missing elements") }}</strong></th>
</tr></thead>
<tbody>
{% for cat_name, cat_data in (coverage.by_category if 'by_category' in coverage else {}).items() %}{% set missing = cat_data.get('missing', []) or [] %}<tr>
<td><strong>{{ _v(cat_name) }}</strong></td>
<td><strong>{{ cat_data.score | int if cat_data.score == cat_data.score | int else cat_data.score }}%</strong></td>
<td>{% if missing | length == 0 %}{{ _("(none)") }}{% elif missing | length <= 8 %}{{ missing | join(', ') }}{% else %}{{ missing[:8] | join(', ') }}… (+{{ missing | length - 8 }}){% endif %}</td>
</tr>
{% endfor %}</tbody></table>
<h2 id='sub-8-2' class='sec-h2'><span>{{ _("8.2 Critical Gaps") }}</span> <em class='brass'>({{ crit_count }})</em></h2>
<p class='note'>{{ _("These") }} {{ crit_count }} {{ _("gaps account for the missing") }} {{ missing_pct }}%.</p>
<table class='tbl'>
<thead><tr>
<th><strong>ID</strong></th>
<th><strong>{{ _("Missing element") }}</strong></th>
<th><strong>{{ _("Severity") }}</strong></th>
<th><strong>{{ _("Category") }}</strong></th>
</tr></thead>
<tbody>
{% for cg in coverage.critical_gaps %}<tr>
<td><strong>{{ cg.id }}</strong></td>
<td>{{ cg.what_is_missing }}</td>
<td><strong>{{ _v(cg.severity) }}</strong></td>
<td>{{ _v(cg.category) }}</td>
</tr>
{% endfor %}</tbody></table>
</section>
