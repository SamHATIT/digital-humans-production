<thead><tr>
<th><strong>{{ _("API name") }}</strong></th>
<th><strong>{{ _("Sharing") }}</strong></th>
<th><strong>{{ _("Purpose") }}</strong></th>
<th><strong>{{ _("# Fields") }}</strong></th>
</tr></thead>
<tbody>
{% for obj in data_model.custom_objects %}<tr>
<td><strong>{{ obj.api_name }}</strong></td>
<td>{{ obj.sharing_model if 'sharing_model' in obj else '—' }}</td>
<td>{{ obj.purpose }}</td>
<td><strong>{{ obj.fields | length }}</strong></td>
</tr>
{% endfor %}</tbody></table>
<h2 id='sub-6-3' class='sec-h2'><span>{{ _("6.3 Custom Object") }}</span> <em class='brass'>{{ _("Field Details") }}</em></h2>
{% for obj in data_model.custom_objects %}<p><strong>{{ obj.api_name if 'api_name' in obj else '?' }}  </strong>({{ obj.label if 'label' in obj else '?' }}) — {{ obj.fields | length if 'fields' in obj else 0 }} {{ _("fields") }}</p>
<p class='note'>{{ obj.purpose }}</p>
<table class='tbl'>
<thead><tr>
<th><strong>{{ _("API name") }}</strong></th>
<th><strong>{{ _("Type") }}</strong></th>
<th><strong>{{ _("Req?") }}</strong></th>
<th><strong>{{ _("Description") }}</strong></th>
</tr></thead>
<tbody>
{% for field in obj.fields %}<tr>
<td><strong>{{ field.api_name }}</strong></td>
<td>{{ field.type }}</td>
<td>{% if field.required %}<strong>✓</strong>{% endif %}</td>
<td>{{ field.description }}</td>
</tr>
{% if 'values' in field %}<tr>
<td></td>
<td></td>
<td></td>
<td><strong>{{ _("Picklist values:") }} </strong><em>{{ field['values'] | join(', ') }}</em></td>
</tr>
{% endif %}{% endfor %}</tbody></table>
{% endfor %}<h2 id='sub-6-4' class='sec-h2'><span>{{ _("6.4 Relationships") }}</span> <em class='brass'>({{ data_model.relationships | length }})</em></h2>
