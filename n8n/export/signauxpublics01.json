    },
    {
      "parameters": {
        "url": "https://www.boamp.fr/api/explore/v2.1/catalog/datasets/boamp/records",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "where",
              "value": "=search(\"salesforce\") OR search(\"Sales Cloud\")"
            },
            {
              "name": "limit",
              "value": "50"
            },
            {
              "name": "order_by",
              "value": "dateparution desc"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "sig-fetch",
      "name": "Interroger le BOAMP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -240,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "// Filtre les avis parus depuis moins de 30 jours et les normalise en SIGNAL.\n// Un signal est une PREUVE PUBLIQUE ET DATEE qu'une organisation investit dans\n// Salesforce maintenant. Sans date ni URL verifiable, le signal ne compte pas.\nconst LIMITE_JOURS = 30;\nconst maintenant = new Date();\nconst sortie = [];\n\nfor (const item of $input.all()) {\n  const res = item.json.results || [item.json];\n  for (const r of res) {\n    if (!r || !r.dateparution) continue;\n    const parution = new Date(r.dateparution);\n    const age = Math.floor((maintenant - parution) / 86400000);\n    if (age > LIMITE_JOURS) continue;\n\n    const acheteur = (r.nomacheteur || '').trim();\n    if (!acheteur) continue;\n\n    sortie.push({ json: {\n      signal_type: 'Appel offres public',\n      signal_source: 'BOAMP',\n      signal_url: 'https://www.boamp.fr/pages/avis/?q=idweb:\"' + r.idweb + '\"',\n      signal_date: r.dateparution,\n      signal_resume: (r.objet || '').slice(0, 400),\n      entreprise: acheteur,\n      echeance: r.datelimitereponse || null,\n      reference: r.idweb,\n      // Un marche public est le signal le plus fort qui soit : budget vote,\n      // besoin decrit, calendrier connu. Bonus de fraicheur.\n      score_signal: age <= 7 ? 9 : (age <= 15 ? 8 : 7)\n    }});\n  }\n}\nreturn sortie;"
      },
      "id": "sig-filter",
      "name": "Filtrer et normaliser",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        380
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO signaux_publics (signal_type, signal_source, signal_url, signal_date, signal_resume, entreprise, echeance, reference, score_signal, statut) VALUES ($1,$2,$3,$4,$5,$6,$7,$8,$9,'nouveau') ON CONFLICT (reference) DO NOTHING",
        "options": {
          "queryReplacement": "={{ $json.signal_type }},{{ $json.signal_source }},{{ $json.signal_url }},{{ $json.signal_date }},{{ $json.signal_resume }},{{ $json.entreprise }},{{ $json.echeance }},{{ $json.reference }},{{ $json.score_signal }}"
        }
      },
      "id": "sig-save",
      "name": "Enregistrer le signal",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        200,
        380
      ],
      "credentials": {
