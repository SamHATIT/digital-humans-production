      "id": "webhook",
      "name": "Webhook Manuel",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        256,
        512
      ],
      "webhookId": "followup-trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.id, l.email, l.name, l.company, l.score, o.subject as last_subject, o.sent_at as last_sent, COUNT(o2.id) as total_emails FROM leads l JOIN outreach_emails o ON l.id = o.lead_id LEFT JOIN outreach_emails o2 ON l.id = o2.lead_id WHERE o.sent_at = (SELECT MAX(sent_at) FROM outreach_emails WHERE lead_id = l.id) AND o.sent_at < NOW() - INTERVAL '3 days' AND o.replied_at IS NULL AND (SELECT COUNT(*) FROM outreach_emails WHERE lead_id = l.id) < 3 GROUP BY l.id, l.email, l.name, l.company, l.score, o.subject, o.sent_at ORDER BY l.score DESC LIMIT 5",
        "options": {}
      },
      "id": "fetch-leads",
      "name": "Fetch Leads to Follow-up",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        512,
        400
      ],
      "credentials": {
        "postgres": {
          "id": "GZbkpedRoAvhZ1O4",
          "name": "Digital Humans PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const leads = $input.all();\nif (leads.length === 0) {\n  return [{json: {skip: true, message: 'Aucun lead à relancer'}}];\n}\n\nconst results = [];\nfor (const item of leads) {\n  const lead = item.json;\n  const followupNum = parseInt(lead.total_emails) + 1;\n  \n  const prompt = `Tu es un expert en relance commerciale B2B pour Digital Humans.\n\nÉcris un email de RELANCE ${followupNum} pour ce lead qui n'a pas répondu:\n- Nom: ${lead.name || 'there'}\n- Entreprise: ${lead.company || 'votre entreprise'}\n- Dernier email: \"${lead.last_subject}\"\n- Envoyé il y a: ${Math.floor((Date.now() - new Date(lead.last_sent).getTime()) / 86400000)} jours\n\nL'email doit:\n1. Être très court (max 80 mots)\n2. Faire référence au premier email\n3. Apporter une nouvelle valeur (stat, cas client, nouveauté)\n4. Terminer par une question simple\n5. Ton amical, pas insistant\n\nRéponds UNIQUEMENT en JSON:\n{\"subject\": \"Re: ...\", \"body\": \"...\"}`;\n\n  results.push({json: {lead_id: lead.id, email: lead.email, name: lead.name, company: lead.company, followup_num: followupNum, prompt}});\n}\nreturn results;"
      },
      "id": "prepare",
      "name": "Prepare Follow-up",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "skip-check",
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-leads",
      "name": "Has Leads?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        912,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent?key={{$env.GEMINI_API_KEY}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"contents\":[{\"parts\":[{\"text\":{{ JSON.stringify($json.prompt) }}}]}],\"generationConfig\":{\"temperature\":0.4,\"maxOutputTokens\":2048}}",
        "options": {
          "timeout": 90000
        }
      },
      "id": "ollama",
      "name": "Generate Follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1104,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const prepareData = $(\"Prepare Follow-up\").first().json;\nconst lead_id = prepareData.lead_id;\nconst email = prepareData.email;\nconst name = prepareData.name;\nconst followup_num = prepareData.followup_num;\n\nconst r = ($json.response || $json.candidates?.[0]?.content?.parts?.[0]?.text || '') || '';\nlet subject = 'Re: Suite à mon précédent message';\nlet body = 'Bonjour, je me permets de revenir vers vous.';\n\ntry {\n  const jsonMatch = r.match(/\\{[\\s\\S]*subject[\\s\\S]*body[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    const p = JSON.parse(jsonMatch[0]);\n    subject = p.subject || subject;\n    body = p.body || body;\n  }\n} catch(e) {}\n\nreturn [{json: {lead_id, email, name, followup_num, subject, body}}];"
      },
      "id": "parse",
      "name": "Parse Follow-up",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1312,
        304
      ]
    },
    {
      "parameters": {
        "fromEmail": "contact@digital-humans.fr",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "options": {}
      },
