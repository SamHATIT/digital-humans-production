    {
      "id": "n2",
      "name": "Check Services",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "command": "python3 -c \"\nimport subprocess, json, datetime\n\nservices = [\n    ('digital-humans-backend','Backend DH'),\n    ('digital-humans-worker','Worker ARQ'),\n    ('digital-humans-frontend','Frontend DH'),\n    ('nginx','Nginx'),\n    ('postgresql','PostgreSQL'),\n    ('n8n','N8N'),\n    ('fail2ban','Fail2ban'),\n    ('mcp-system-server','MCP Server'),\n]\ndown=[]; lines=[]\nfor svc,label in services:\n    r=subprocess.run(['systemctl','is-active',svc],capture_output=True,text=True)\n    ok=r.stdout.strip()=='active'\n    lines.append(('✅ ' if ok else '❌ ')+label+': '+r.stdout.strip())\n    if not ok: down.append(label)\n\nr=subprocess.run(['docker','ps','--format','{{.Names}}|{{.Status}}'],capture_output=True,text=True)\nfor line in r.stdout.strip().split('\\n'):\n    if '|' in line:\n        n,s=line.split('|',1)\n        ok='unhealthy' not in s and 'Exited' not in s\n        lines.append(('✅ ' if ok else '❌ ')+'[Docker] '+n+': '+s[:25])\n        if not ok: down.append('[Docker] '+n)\n\nr=subprocess.run(['free','-m'],capture_output=True,text=True)\nm=r.stdout.split('\\n')[1].split()\npct=round(int(m[2])/int(m[1])*100)\nlines.append('💾 RAM: '+m[2]+'MB/'+m[1]+'MB ('+str(pct)+'%)')\nif pct>90: down.append('RAM critique ('+str(pct)+'%)')\n\nr=subprocess.run(['df','/'],capture_output=True,text=True)\nd=r.stdout.split('\\n')[1].split()\ndpct=int(d[4].replace('%',''))\nlines.append('💿 Disque: '+d[3]+' libres ('+str(dpct)+'% utilisé)')\nif dpct>85: down.append('Disque critique ('+str(dpct)+'%)')\n\nprint(json.dumps({'down':down,'issues':len(down)>0,'lines':chr(10).join(lines),'ts':datetime.datetime.now().strftime('%d/%m %H:%M')}))\n\"\n"
      }
    },
